{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build ATM Application",
            "type": "shell",
            "command": "javac -sourcepath src -d out src/app/Main.java",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$javac"]
        },
        {
            "label": "Run ATM Application",
            "type": "shell",
            "command": "java -cp out app.Main",
            "dependsOn": "Build ATM Application",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
